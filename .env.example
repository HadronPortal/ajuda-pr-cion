# Chave server-side do monitor SEFAZ da FiscalAPI.
# Cadastre-se em https://app.fiscalapi.com.br e nunca use o prefixo VITE_.
FISCAL_API_KEY=fapi_sua_chave_aqui

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Conexao privada usada somente pelas Server Functions. Nunca use o prefixo VITE_.
DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres

# Provedor server-side para busca avançada de CNPJ por cidade/UF.
# A fonte deve oferecer POST com filtros de município, situação, abertura e CNAE.
LEADS_API_URL=https://api.apicnpjs.com.br/v1/cnpj/search
LEADS_API_KEY=sua_chave_privada
# Importação mensal dos Dados Abertos do CNPJ (execução local)
# CNPJ_SOURCE_DIR=C:\caminho\para\os-zips-da-receita
# CNPJ_BASE_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos
# CNPJ_COMPETENCE=2026-07-12
# CNPJ_CACHE_DIR=.cache/cnpj
# CNPJ_IMPORT_BATCH=1000
